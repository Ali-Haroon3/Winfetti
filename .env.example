# Local dev defaults; docker-compose supplies its own DATABASE_URL/REDIS_URL.
DATABASE_URL=postgresql+psycopg://winfetti:winfetti@localhost:5432/winfetti
REDIS_URL=redis://localhost:6379/0

# REQUIRED in any deployed environment.
JWT_SECRET=dev-secret-change-me

# Admin queue endpoints return 503 until this is set.
ADMIN_API_KEY=

# True assumes one edge proxy (Fly/Railway) appending the real client IP to
# X-Forwarded-For. Set false if the app is exposed directly.
TRUST_PROXY_HEADERS=true

# Phase 2 webhooks — each endpoint returns 503 until its secret is set.
# AdMob SSV needs no secret (verifies against Google's published keys).
TAPJOY_SECRET=
REVENUECAT_WEBHOOK_AUTH=
STRIPE_WEBHOOK_SECRET=
AD_REWARD_COINS=250
MAX_OFFER_COINS_PER_POSTBACK=50000

# Phase 3: affiliate cashback (pending until matured), Sentry.
AFFILIATE_SECRET=
CASHBACK_MATURATION_DAYS=30
CASHBACK_SHARE=0.5
SENTRY_DSN=

# In-process scheduler: the API runs its own maintenance jobs (cashback
# maturation, stuck-redemption retries, token purges) — no external cron.
# Safe with multiple replicas; set an interval to 0 to disable one job.
SCHEDULER_ENABLED=true
SCHEDULER_MATURE_CASHBACK_EVERY_SECONDS=3600
SCHEDULER_RETRY_REDEMPTIONS_EVERY_SECONDS=300
SCHEDULER_PURGE_EMAIL_TOKENS_EVERY_SECONDS=86400
# An 'approved' redemption older than this is considered stuck (its
# fulfillment call failed or crashed) and is re-driven automatically.
REDEMPTION_RETRY_STUCK_AFTER_SECONDS=900

# Email delivery. Verification emails go out over SMTP once SMTP_HOST and
# EMAIL_FROM are set (SES/Postmark/Mailgun SMTP endpoints all work);
# otherwise they are logged only — and nobody can pass the email_verified
# redemption gate in production without a real sender.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=
# Optional deep link included in the email; must contain {token}.
EMAIL_VERIFY_LINK_TEMPLATE=

# Tremendous sandbox (testflight). Leave the key empty to use the in-memory
# stub — no real money can move without it.
TREMENDOUS_API_KEY=
TREMENDOUS_BASE_URL=https://testflight.tremendous.com/api/v2
TREMENDOUS_FUNDING_SOURCE_ID=balance
TREMENDOUS_CAMPAIGN_ID=
